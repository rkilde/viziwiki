# Supabase (phase 1 — content persistence). Copy to .env.local and fill in
# from the dashboard: supabase.com/dashboard → your project → Settings → API.
# Set the SAME two vars in Vercel (Project → Settings → Environment Variables)
# so deployed previews save to the cloud too. Unset = builder uses localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
