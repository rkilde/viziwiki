{
  "field_types": {
    "text": "single-line input",
    "richtext": "small rich editor — inline HTML / bold / links",
    "number": "number input",
    "date": "month/date picker (stored as a display string e.g. 'May 2019')",
    "bool": "toggle",
    "enum": "fixed choice → dropdown, written enum[a,b,c]",
    "list": "repeatable group (add/remove rows), written list<subtype>",
    "media": "image/file upload → Supabase Storage",
    "icon": "picker from the universal icon sprite",
    "color": "swatch — a skin-token reference or a content hex",
    "url": "validated link"
  },
  "canon": [
    "hero",
    "overview",
    "spec",
    "config",
    "lifecycle-lane",
    "timeline",
    "delta",
    "catalog"
  ],
  "page_types": {
    "standard": {
      "hero_variant": "standard",
      "sections": [
        "hero",
        "overview",
        "spec",
        "config",
        "lifecycle-lane",
        "timeline",
        "delta",
        "catalog"
      ],
      "section_rules": {
        "hero": {
          "min": 1,
          "max": 1,
          "locked_first": true,
          "variant": "standard"
        },
        "*": {
          "min": 0,
          "max": "unbounded"
        }
      }
    },
    "home": {
      "hero_variant": "search",
      "sections": [
        "hero",
        "overview",
        "spec",
        "config",
        "lifecycle-lane",
        "timeline",
        "delta",
        "catalog"
