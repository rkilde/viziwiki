      "fields": {
        "title": {
          "type": "text",
          "required": true,
          "blank": "Page title",
          "help": "Big H1 (the trailing period is automatic)"
        },
        "eyebrow": {
          "type": "text",
          "blank": "Category label",
          "help": "Small category tag above the title"
        },
        "subtitle": {
          "type": "text",
          "blank": "Subtitle",
          "help": "A line under the H1"
        },
        "subtitle_meta": {
          "type": "text",
          "blank": "Model number",
          "requires": "subtitle",
          "help": "Mono tag after a ' · ' (e.g. a model number)"
        },
        "desc": {
          "type": "richtext",
          "blank": "Write a short lead paragraph for this page.",
          "help": "One-paragraph lead"
        },
        "stats": {
          "type": "list<stat>",
          "min": 4,
          "max": 4,
          "help": "The 1×4 number grid — always exactly 4 cells (canon)",
          "blank": [
            {
              "num": "Value",
              "label": "Stat label"
            },
            {
              "num": "Value",
              "label": "Stat label"
            },
            {
              "num": "Value",
              "label": "Stat label"
            },
            {
              "num": "Value",
              "label": "Stat label"
            }
          ]
        },
        "search": {
          "type": "bool",
          "default": false,
          "help": "Show the search bar — HOME pages only (page type sets this)"
        },
        "search_placeholder": {
          "type": "text",
          "blank": "Search this wiki…",
          "help": "Search box placeholder — home only"
        },
        "spotlight": {
          "type": "spotlight",
          "help": "Optional card aside (advanced — the spotlight bank)",
          "blank": {
            "eyebrow": "Spotlight",
            "title": "Spotlight title",
            "desc": "Write a short description.",
            "tags": [
              "Tag"
            ],
            "cta": "Button label"
          }
        },
        "feature": {
          "type": "feature",
          "help": "Optional feature aside (advanced — the feature bank)",
          "blank": {
            "head_left": "Featured",
            "title": "Feature title",
            "desc": "Write a short description.",
            "chips": [
              {
                "key": "Label",
                "val": "Value"
              },
              {
                "key": "Label",
                "val": "Value"
              },
              {
                "key": "Label",
                "val": "Value"
              }
            ]
          }
        }
      },
      "subtypes": {
        "stat": {
          "num": {
            "type": "text",
            "required": true
          },
          "label": {
            "type": "text",
            "required": true
          }
        },
        "spotlight": {
          "eyebrow": {
            "type": "text",
            "blank": "Spotlight"
          },
          "title": {
            "type": "text",
            "required": true,
            "blank": "Spotlight title"
          },
          "desc": {
            "type": "richtext",
            "blank": "Write a short description."
          },
          "tags": {
            "type": "list<text>",
            "item_blank": "Tag"
          },
          "cta": {
            "type": "text",
            "required": true,
            "blank": "Button label",
            "help": "REQUIRED button label (the call to action); cta_href makes it a link"
          },
          "cta_href": {
            "type": "url"
          },
          "class": {
            "type": "text",
            "locked": true,
            "help": "Extra classes (skin flourish)"
          },
          "art": {
            "type": "text",
            "locked": true,
            "help": "Raw decoration markup (admin)"
          },
          "art_inc": {
            "type": "text",
            "locked": true,
            "help": "Decoration partial name under hero/ (admin)"
          }
        },
        "feature": {
          "bg": {
            "type": "text",
            "locked": true,
            "help": "--hero-feature-bg gradient/colour (skin/admin)"
          },
          "head_left": {
            "type": "text",
            "blank": "Featured"
          },
          "head_right": {
            "type": "text",
            "blank": "Label"
          },
          "title": {
            "type": "text",
            "required": true,
            "blank": "Feature title"
          },
          "desc": {
            "type": "richtext",
            "blank": "Write a short description."
          },
          "chips": {
            "type": "list<chip>",
            "required": true,
            "min": 3,
            "max": 3,
            "help": "EXACTLY 3 stat chips (key/value) — fixed, not addable/removable"
          }
        },
        "chip": {
          "key": {
            "type": "text",
            "required": true
          },
          "val": {
            "type": "text",
            "required": true
          }
        }
      },
      "note": "Both asides are 'hero cards' (mutually exclusive — at most one): spotlight = the Call-to-Action card (CTA required), feature = the Feature card (exactly 3 fixed chips). search is HOME-only.",
      "seed": {
        "title": "New page title",
        "eyebrow": "Category label",
        "desc": "A short lead sentence about this page."
      },
      "min": "title"
    },
