      "section_rules": {
        "hero": {
          "min": 1,
          "max": 1,
          "locked_first": true,
          "variant": "search"
        },
        "*": {
          "min": 0,
          "max": "unbounded"
        }
      }
    }
  },
  "components": {
    "hero": {
