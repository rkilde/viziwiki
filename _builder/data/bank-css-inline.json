"/* bank-catalog.css */\n/* ════════════════════════════════════════════════════════════════════\n   BANK · CATALOG  +  paired EXPANDABLE CARD\n   --------------------------------------------------------------------\n   The first data-driven bank component. Structure + shape are universal;\n   every color comes from skin/universal tokens (no hardcoded surfaces —\n   modest fallbacks only). The catalog SECTION (sections/catalog-section)\n   owns the framing — eyebrow (\"Full Catalog\") + the upper-right derived\n   summary, both on universal DOCUMENT classes; the VISUAL below is widget\n   type, owned here in the bank.\n   ════════════════════════════════════════════════════════════════════ */\n\n/* ── Catalog SECTION chrome — eyebrow (left) + summary (upper-right) ─── */\n.catalog .cat-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:24px}\n.catalog .cat-summary{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--wiki-text-muted-color,#777)}\n\n/* ── Catalog VISUAL (the masonry list) ──────────────────────────────── */\n.catalog .cat-masonry{columns:2;column-gap:16px}\n\n.cat-card{position:relative;overflow:hidden;break-inside:avoid;margin-bottom:16px;\n  background:var(--wiki-surface-bg,#fff);border:1px solid var(--wiki-cat-divider-color,rgba(0,0,0,.1));border-left:4px solid var(--cat-color);\n  border-radius:var(--wiki-card-radius,14px);padding:20px}\n.cat-card-title{font-family:'Fraunces',Georgia,serif;font-size:17px;font-weight:600;letter-spacing:-.01em;color:var(--cat-color)}\n.cat-card-count{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--wiki-text-muted-color,#777);margin-top:4px}\n/* reserve corner room when a ribbon is present so title/count wrap before it */\n.cat-card.has-ribbon .cat-card-title,.cat-card.has-ribbon .cat-card-count{padding-right:84px}\n.cat-card-divider{height:1px;background:var(--wiki-cat-divider-color,rgba(0,0,0,.1));margin:12px 0}\n.cat-card-pills{display:flex;flex-wrap:wrap}\n/* --cat-pill-fg: THE single tweak point for every item-pill's resting text\n   color, site-wide. Foreground blended 85% onto the card (sRGB) — the exact\n   equivalent of the original rgba(foreground, .85) over a white card, the\n   \"slightly dropped\" look. (Mixing with transparent in oklab darkened it.)\n   Each skin's --foreground + --card flow through. Hover swaps to --cat-color. */\n.cat-pill{display:inline-block;margin:0 6px 6px 0;padding:5px 12px;border:1px solid var(--wiki-cat-divider-color,rgba(0,0,0,.1));border-radius:4px;\n  background:var(--wiki-surface-bg,#fff);color:var(--cat-pill-fg,color-mix(in srgb,var(--wiki-text-color,#2a1f15) 85%,var(--wiki-surface-bg,#fff)));font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10px;font-weight:500;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:background .15s,border-color .15s,color .15s}\n.cat-pill:hover{background:color-mix(in oklab,var(--cat-color) 9%,var(--wiki-surface-bg,#fff));border-color:color-mix(in oklab,var(--cat-color) 45%,transparent);color:var(--cat-color)}\n\n/* ADD-ON: ribbon (corner banner, typed text) */\n.cat-ribbon{position:absolute;top:0;right:0;width:104px;height:104px;overflow:hidden;pointer-events:none}\n.cat-ribbon span{position:absolute;top:30px;right:-42px;width:180px;padding:4px 0;transform:rotate(45deg);text-align:center;\n  background:var(--cat-color);color:#fff;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8px;font-weight:700;letter-spacing:.10em;text-transform:uppercase}\n/* \"gone\" tone — DERIVED from the contract neutral (a desaturated \"phased out\"\n   banner), darkened toward the wiki's text color. Does NOT use --cat-color. */\n.cat-ribbon.ribbon-gone span{background:color-mix(in oklab,var(--wiki-neutral) 72%,var(--wiki-text-color,#000) 28%);color:#fff}\n\n/* ADD-ON: footer note (mono box, max 1) */\n.cat-footnote{margin-top:8px;padding:14px 18px;border:1px solid var(--wiki-cat-divider-color,rgba(0,0,0,.1));border-radius:6px;background:var(--wiki-surface-bg,#fff);\n  font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10px;line-height:1.7;letter-spacing:.03em;color:var(--wiki-text-muted-color,#777)}\n.cat-footnote b{color:var(--wiki-text-color,#222);font-weight:600}\n\n/* hidden detail source (cloned into the modal on click) */\n.cat-details{display:none}\n\n/* ── Expandable Card (modal) ────────────────────────────────────────── */\n/* z-index 999: the expanded card sits ABOVE all page chrome — the top nav\n   (100), the Contents rail (110), every backdrop — so the WHOLE page dims and\n   goes inoperable behind it (the original hand-built behavior). fixed+inset:0\n   centers the card in the true viewport, unaffected by rail state or content\n   padding. Dim tint = the skin's own foreground (TB's warm brown), universal. */\n.modal-ov{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:20px;z-index:999;background:color-mix(in oklab,var(--wiki-text-color,#000) 52%,transparent);backdrop-filter:blur(4px)}\n.modal-ov.open{display:flex}\n.modal-card{position:relative;width:100%;max-width:460px;background:var(--wiki-surface-bg,#fff);border-radius:var(--wiki-card-radius,14px);border-left:5px solid var(--cat-color);box-shadow:0 24px 64px rgba(0,0,0,.28);overflow:clip}\n.modal-scroll{max-height:85vh;overflow-y:auto;padding:24px 24px 22px}\n.modal-close{position:absolute;top:14px;right:14px;width:26px;height:26px;border:0;border-radius:50%;cursor:pointer;background:var(--wiki-surface-bg,#fff);box-shadow:0 0 0 1px var(--wiki-cat-divider-color,rgba(0,0,0,.1));color:var(--wiki-text-muted-color,#777);font-size:15px;line-height:1;z-index:5}\n.modal-card .cat-ribbon{z-index:2;width:120px;height:120px}\n.modal-card .cat-ribbon span{top:36px;right:-46px;width:206px;font-size:7.5px}\n.modal-headrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-right:44px}\n.modal-card.has-ribbon .modal-headrow{padding-right:74px}\n.modal-eyebrow{display:inline-flex;align-items:center;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:9px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--wiki-text-muted-color,#777);line-height:1}\n.chip{border-radius:var(--wiki-chip-radius,999px);padding:3px 10px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;display:inline-flex;align-items:center;line-height:1;white-space:nowrap}\n.chip.info{background:color-mix(in oklab,var(--cat-color) 12%,var(--wiki-surface-bg,#fff));color:var(--cat-color)}\n/* status chips — DERIVED from the contract meaning colors (not skin --st-*):\n   active→positive, limited→warning, discontinued+retired→neutral (both \"gone\").\n   bg = a light tint of the meaning on the surface; fg = the meaning darkened\n   toward the wiki's text color for readable contrast. */\n.chip.st-active{background:color-mix(in oklab,var(--wiki-positive) 16%,var(--wiki-surface-bg,#fff));color:color-mix(in oklab,var(--wiki-positive) 72%,var(--wiki-text-color,#000))}\n.chip.st-limited{background:color-mix(in oklab,var(--wiki-warning) 16%,var(--wiki-surface-bg,#fff));color:color-mix(in oklab,var(--wiki-warning) 72%,var(--wiki-text-color,#000))}\n.chip.st-discontinued{background:color-mix(in oklab,var(--wiki-neutral) 16%,var(--wiki-surface-bg,#fff));color:color-mix(in oklab,var(--wiki-neutral) 72%,var(--wiki-text-color,#000))}\n.chip.st-retired{background:color-mix(in oklab,var(--wiki-neutral) 16%,var(--wiki-surface-bg,#fff));color:color-mix(in oklab,var(--wiki-neutral) 72%,var(--wiki-text-color,#000))}\n.modal-title{font-family:'Fraunces',Georgia,serif;font-size:24px;font-weight:600;letter-spacing:-.01em;line-height:1.1;margin:10px 0 0;color:var(--wiki-text-color,#222)}\n/* hairline between the header (eyebrow+title) and the body — full card width\n   (breaks out of the .modal-scroll 24px padding); the inset variant is the\n   content-width rule that sets off the \"See full entry\" footer. One edit\n   here propagates to every catalog card sitewide. */\n.modal-divider{height:1px;background:var(--wiki-cat-divider-color,rgba(0,0,0,.1));margin:16px -24px 0}\n.modal-divider.is-inset{margin:20px 0 0}\n.modal-desc{font-family:'Spectral',Georgia,serif;font-size:14px;line-height:1.55;color:color-mix(in oklab,var(--wiki-text-color,#222) 85%,transparent);margin-top:10px}\n.modal-group-label{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:8px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--wiki-text-muted-color,#777);margin:18px 0 8px}\n.gpill{display:inline-block;margin:0 5px 5px 0;padding:3px 9px;border-radius:3px;border:1px solid color-mix(in oklab,var(--cat-color) 25%,transparent);\n  background:color-mix(in oklab,var(--cat-color) 7%,var(--wiki-surface-bg,#fff));color:var(--cat-color);\n  font-family:'JetBrains Mono',ui-monospace,monospace;font-size:9px;font-weight:500;letter-spacing:.08em;text-transform:uppercase}\n.gpill.struck{text-decoration:line-through;border-color:var(--wiki-cat-divider-color,rgba(0,0,0,.1));background:color-mix(in oklab,var(--wiki-text-color,#222) 4%,transparent);color:var(--wiki-text-muted-color,#777);filter:grayscale(1)}\n.modal-callout{margin-top:18px;padding:12px 14px;border-radius:6px;border-left:3px solid var(--cat-color);background:color-mix(in oklab,var(--cat-color) 6%,var(--wiki-surface-bg,#fff))}\n.modal-callout-label{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:9px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--cat-color);margin-bottom:5px}\n.modal-callout-text{font-family:'Spectral',Georgia,serif;font-size:14px;line-height:1.5;color:var(--wiki-text-color,#222)}\n.modal-note{margin-top:16px;padding-top:12px;border-top:1px solid var(--wiki-cat-divider-color,rgba(0,0,0,.1));font-family:'Spectral',Georgia,serif;font-size:12.5px;font-style:italic;line-height:1.55;color:var(--wiki-text-muted-color,#777)}\n.modal-cta{display:inline-flex;align-items:center;gap:6px;margin-top:16px;padding-bottom:2px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--cat-color);text-decoration:none;border-bottom:1px solid color-mix(in oklab,var(--cat-color) 32%,transparent)}\n\n/* ── Mobile — single column + tighter spacing + smaller ribbons ─────── */\n@media(max-width:640px){\n  .catalog .cat-masonry{columns:1;column-gap:0}\n  .cat-card{padding:16px}\n  .cat-ribbon{width:88px;height:88px}\n  .cat-ribbon span{top:22px;right:-38px;width:156px;font-size:7px}\n  .modal-ov{padding:12px}\n  .modal-scroll{padding:20px 16px 18px}\n  .modal-card.has-ribbon .modal-headrow{padding-right:66px}\n  .modal-title{font-size:21px}\n  .modal-desc{font-size:13.5px}\n  .modal-card .cat-ribbon{width:104px;height:104px}\n  .modal-card .cat-ribbon span{top:28px;right:-42px;width:182px;font-size:7px}\n}\n\n/* bank-config.css */\n/* ════════════════════════════════════════════════════════════════════\n   BANK · CONFIG  (storage / configuration chart)\n   --------------------------------------------------------------------\n   A contained chart: capacity rows with proportional fill bars, price,\n   dates, and device-color dots. Bar widths are DERIVED from capacity in\n   the visual (Liquid), so authors enter only the number.\n\n   Colors are SKIN-DERIVED. The chart reads a handful of --cfg-* tokens,\n   each defaulting to a sensible mix of the wiki's base palette\n   (--foreground / --card / --wiki-accent). A wiki that never touches a chart\n   still gets a coherent one (light chrome, an emphasis-colored bar). A\n   skin can pin any token to lock an exact look — e.g. the Apple skin pins\n   the originals (#fff / #f4f4f6 / #c7c7cc / #0a0a0a) so the iPod chart is\n   byte-identical, via `body.wiki-apple .config { … }`.\n   Device-color dots are CONTENT (real product hex), not theme.\n   ════════════════════════════════════════════════════════════════════ */\n\n/* ── skin-derived chrome tokens (defined once; a skin can override) ──── */\n.config{\n  --cfg-ink:     var(--wiki-text-color, #0a0a0a);                                                  /* primary text  */\n  --cfg-surface: var(--wiki-surface-bg, #fff);                                                           /* chart box bg  */\n  --cfg-track:   color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 4%, var(--wiki-surface-bg, #fff));       /* empty track   */\n  --cfg-bar:     var(--wiki-accent-on-light, color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 22%, var(--wiki-surface-bg, #fff))); /* the fill — emphasis */\n  --cfg-bar-ink: color-mix(in oklab, var(--cfg-ink) 72%, transparent);                        /* text on the bar */\n  --cfg-line:    var(--wiki-divider-color, color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 10%, transparent)); /* hairlines */\n}\n\n/* ── intro prose ────────────────────────────────────────────────────── */\n.cfg-prose{max-width:720px;margin-bottom:36px;}\n.cfg-prose p{font-size:var(--wiki-prose-size);color:color-mix(in oklab,var(--cfg-ink) 78%,transparent);line-height:var(--wiki-prose-leading);margin-bottom:16px;}\n.cfg-prose p:last-child{margin-bottom:0;}\n.cfg-prose p strong{color:var(--cfg-ink);font-weight:600;}\n\n/* ── chart box ──────────────────────────────────────────────────────── */\n.cfg-chart{background:var(--cfg-surface);border:1px solid var(--cfg-line);border-radius:14px;padding:24px;}\n.cfg-chart-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;gap:12px;flex-wrap:wrap;}\n.cfg-chart-title{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:16px;font-weight:600;letter-spacing:-0.01em;color:var(--cfg-ink);}\n.cfg-chart-sub{font-family:\"JetBrains Mono\",monospace;font-size:8px;text-transform:uppercase;letter-spacing:.14em;color:color-mix(in oklab,var(--cfg-ink) 38%,transparent);}\n.cfg-bars{display:flex;flex-direction:column;gap:10px;}\n.cfg-row{display:grid;grid-template-columns:56px 1fr 76px;row-gap:2px;column-gap:12px;align-items:center;}\n.cfg-date-row{grid-column:2 / -1;padding-left:4px;}\n.cfg-cap{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:22px;font-weight:700;letter-spacing:-0.03em;text-align:right;color:var(--cfg-ink);}\n.cfg-cap span{font-size:11px;font-weight:400;color:color-mix(in oklab,var(--cfg-ink) 35%,transparent);margin-left:1px;}\n.cfg-track{height:48px;background:var(--cfg-track);border-radius:8px;position:relative;overflow:hidden;border:1px solid var(--cfg-line);}\n.cfg-fill{height:100%;background:var(--cfg-bar);border-radius:7px;display:flex;align-items:center;padding:0 12px;gap:8px;}\n.cfg-fill-rev{background:repeating-linear-gradient(-45deg,var(--cfg-bar),var(--cfg-bar) 3px,color-mix(in oklab,var(--cfg-bar) 92%,#000) 3px,color-mix(in oklab,var(--cfg-bar) 92%,#000) 4px);}\n.cfg-fill .cfg-dates{display:none;}\n.cfg-model{font-family:\"JetBrains Mono\",monospace;font-size:7px;text-transform:uppercase;letter-spacing:.1em;color:var(--cfg-bar-ink);white-space:nowrap;}\n.cfg-dates{font-family:\"JetBrains Mono\",monospace;font-size:8px;letter-spacing:.04em;color:color-mix(in oklab,var(--cfg-ink) 62%,transparent);white-space:nowrap;margin-top:3px;display:block;}\n.cfg-price{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:18px;font-weight:600;letter-spacing:-0.02em;text-align:right;color:var(--cfg-ink);white-space:nowrap;}\n.cfg-price-line{line-height:1.18;}\n.cfg-price-arrow{font-family:\"JetBrains Mono\",monospace;font-size:13px;font-weight:400;letter-spacing:0;vertical-align:middle;}\n\n/* ── revised-group divider ──────────────────────────────────────────── */\n.cfg-divider{height:1px;background:var(--cfg-line);margin:4px 0;}\n.cfg-divider-label{font-family:\"JetBrains Mono\",monospace;font-size:7px;text-transform:uppercase;letter-spacing:.14em;color:color-mix(in oklab,var(--cfg-ink) 32%,transparent);margin-top:6px;margin-bottom:2px;}\n\n/* ── device-color dots (content hex, not theme) ────────────────────── */\n.cfg-colors{grid-column:2 / -1;display:flex;align-items:flex-start;gap:10px;justify-content:flex-start;flex-wrap:wrap;padding-left:4px;margin-top:2px;}\n.cfg-color{display:flex;flex-direction:column;align-items:center;gap:4px;width:34px;}\n.cfg-dot{width:16px;height:16px;border-radius:50%;flex-shrink:0;box-shadow:0 1px 2px color-mix(in oklab,var(--cfg-ink) 12%,transparent);}\n.cfg-dot.ring{box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--cfg-ink) 32%,transparent),0 1px 2px color-mix(in oklab,var(--cfg-ink) 8%,transparent);}\n.cfg-dot-name{font-family:\"JetBrains Mono\",monospace;font-size:8px;font-weight:500;text-transform:uppercase;letter-spacing:.06em;color:color-mix(in oklab,var(--cfg-ink) 50%,transparent);text-align:center;line-height:1.2;width:100%;}\n\n/* ── footer spec line ───────────────────────────────────────────────── */\n.cfg-footer{margin-top:16px;padding-top:14px;border-top:1px solid var(--cfg-line);font-family:\"JetBrains Mono\",monospace;font-size:8px;text-transform:uppercase;letter-spacing:.12em;color:color-mix(in oklab,var(--cfg-ink) 35%,transparent);line-height:1.6;}\n\n@media(max-width:600px){\n  .cfg-chart{padding:16px;}\n  .cfg-row{grid-template-columns:44px minmax(0,1fr) auto;column-gap:10px;}\n  .cfg-cap{font-size:18px;}\n  .cfg-track{height:40px;min-width:0;}\n  .cfg-model{font-size:6px;}\n  .cfg-price-arrow{font-size:12px;}\n  .cfg-price{font-size:15px;}\n  .cfg-chart-head{flex-direction:column;gap:4px;}\n  .cfg-dot{width:15px;height:15px;}\n  .cfg-dot-name{font-size:7.5px;}\n  .cfg-colors{gap:8px;}\n}\n\n/* bank-delta.css */\n/* ════════════════════════════════════════════════════════════════════\n   BANK · DELTA  —  the \"Changes & Improvements\" comparison table\n   --------------------------------------------------------------------\n   A side-by-side comparison of two things (previous | current) across\n   Hardware + Software rows, each current value optionally carrying a\n   colored CHIP that signals the DIRECTION of the change (the text says\n   the value). Structure + type live here (single source); the section\n   frame lives in _includes/sections/delta-section.html.\n\n   Colors are SKIN-DERIVED (same pattern as the timeline/config banks):\n   the table reads --gd-* tokens, each defaulting to a mix of the wiki's\n   base palette (--foreground / --card), so any wiki gets a coherent\n   table. A skin can pin a token to lock a look — the Apple skin pins the\n   originals so the iPod comparison is unchanged.\n\n   THE CHIP VOCABULARY (color = the judgment; text = the value):\n     better  · green  — new, or quantifiably better   (256 GB, +33%, A10)\n     feature · blue   — a marquee feature highlighted  (Retina, AR, Metal)\n     changed · amber  — a lateral change, no +/-       (Lightning, 6 colors)\n     worse   · red    — regressed / removed            (Gone)\n     same    · gray   — no change                      (Same)\n   ════════════════════════════════════════════════════════════════════ */\n\n.delta{\n  --gd-ink:        var(--wiki-text-color, #0a0a0a);\n  --gd-surface:    var(--wiki-surface-bg, #fff);\n  --gd-line:       color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 10%, transparent);\n  --gd-line-soft:  color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 7%, transparent);\n  --gd-current-bg: var(--wiki-text-color, #0a0a0a);                                   /* the dark CURRENT header */\n  --gd-current-ink:var(--wiki-surface-bg, #fff);\n  --gd-prev-bg:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 4%,  var(--wiki-surface-bg, #fff));\n  --gd-label-bg:   color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 9%,  var(--wiki-surface-bg, #fff));\n  --gd-sec-bg:     color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 2%,  var(--wiki-surface-bg, #fff));\n  --gd-old-bg:     color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 2.5%, transparent);\n  /* chips — semantic defaults; a skin may pin any of them */\n  --gd-better-bg:#dcfce7;  --gd-better-bd:#bbf7d0;  --gd-better-fg:#15803d;\n  --gd-feature-bg:#eff6ff; --gd-feature-bd:#bfdbfe; --gd-feature-fg:#1d4ed8;\n  --gd-changed-bg:#fef9c3; --gd-changed-bd:#fef08a; --gd-changed-fg:#a16207;\n  --gd-worse-bg:#fee2e2;   --gd-worse-bd:#fecaca;   --gd-worse-fg:#b91c1c;\n  --gd-same-bg:#f3f4f6;    --gd-same-bd:#e5e7eb;    --gd-same-fg:#6b7280;\n}\n\n.delta-prose{max-width:65ch;margin-bottom:24px;}\n.delta-prose p{font-size:var(--wiki-prose-size,16px);line-height:var(--wiki-prose-leading,1.65);color:color-mix(in oklab,var(--gd-ink) 80%,transparent);}\n.delta-prose p strong{color:var(--gd-ink);font-weight:600;}\n\n/* Table — border-collapse keeps every column divider one continuous line */\n.gd-wrap{overflow-x:auto;}\n.gd{width:100%;border-collapse:collapse;table-layout:fixed;border:1px solid var(--gd-line);border-radius:12px;overflow:hidden;background:var(--gd-surface);}\n.gd col.gd-c1{width:200px;}\n.gd col.gd-c2,.gd col.gd-c3{width:auto;}\n.gd td{vertical-align:middle;border-right:1px solid var(--gd-line-soft);border-bottom:1px solid var(--gd-line-soft);}\n.gd td:last-child{border-right:none;}\n.gd tr:last-child td{border-bottom:none;}\n\n/* Gen header row */\n.gd-gen td{padding:16px 20px;border-bottom:1px solid var(--gd-line);}\n.gd-gen .gd-gen-label{background:var(--gd-label-bg);}\n.gd-gen .gd-gen-old{background:var(--gd-prev-bg);}\n.gd-gen .gd-gen-new{background:var(--gd-current-bg);border-right-color:color-mix(in oklab,var(--gd-current-ink) 10%,transparent);}\n.gd-tag{display:block;font-family:\"JetBrains Mono\",monospace;font-size:8px;text-transform:uppercase;letter-spacing:.18em;color:color-mix(in oklab,var(--gd-ink) 40%,transparent);margin-bottom:4px;}\n.gd-gen-new .gd-tag{color:color-mix(in oklab,var(--gd-current-ink) 45%,transparent);}\n.gd-name{display:block;font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:17px;font-weight:600;letter-spacing:-0.01em;color:var(--gd-ink);}\n.gd-gen-new .gd-name{color:var(--gd-current-ink);}\n.gd-year{display:block;font-family:\"JetBrains Mono\",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:color-mix(in oklab,var(--gd-ink) 35%,transparent);margin-top:3px;}\n.gd-gen-new .gd-year{color:color-mix(in oklab,var(--gd-current-ink) 30%,transparent);}\n\n/* Section label rows (HARDWARE / SOFTWARE) — .gd-sec-main is a table-cell so\n   it stretches to the row height (fixes the mobile crooked rows). */\n.gd-sec td{background:var(--gd-sec-bg);padding:10px 20px;border-top:1px solid var(--gd-line);border-bottom:1px solid var(--gd-line-soft);font-family:\"JetBrains Mono\",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.18em;color:var(--gd-ink);}\n.gd-sec-main{white-space:nowrap;}\n.gd-sec-main svg{vertical-align:-2px;margin-right:6px;}\n.gd-sec-col{letter-spacing:.14em;}\n\n/* Data rows */\n.gd-label{padding:14px 20px;}\n.gd-label-name{display:block;font-family:\"JetBrains Mono\",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.14em;color:var(--gd-ink);}\n.gd-old{padding:14px 20px;background:var(--gd-old-bg);}\n.gd-old-val{font-size:13px;color:color-mix(in oklab,var(--gd-ink) 72%,transparent);line-height:1.45;}\n.gd-old-val.missing{font-style:italic;color:color-mix(in oklab,var(--gd-ink) 55%,transparent);}\n.gd-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:color-mix(in oklab,var(--gd-ink) 12%,transparent);margin-right:8px;vertical-align:middle;}\n.gd-new{padding:14px 20px;}\n.gd-new-val{font-size:13px;color:var(--gd-ink);line-height:1.45;}\n.gd-new-val strong{font-weight:600;}\n\n/* CHIPS — the 5 canonical states */\n.gd-chip{display:inline-block;font-family:\"JetBrains Mono\",monospace;font-size:6.5px;text-transform:uppercase;letter-spacing:.1em;padding:2px 5px;border-radius:3px;border:1px solid;white-space:nowrap;margin-top:6px;margin-left:7px;}\n.gd-chip-better {background:var(--gd-better-bg); border-color:var(--gd-better-bd); color:var(--gd-better-fg);}\n.gd-chip-feature{background:var(--gd-feature-bg);border-color:var(--gd-feature-bd);color:var(--gd-feature-fg);}\n.gd-chip-changed{background:var(--gd-changed-bg);border-color:var(--gd-changed-bd);color:var(--gd-changed-fg);}\n.gd-chip-worse  {background:var(--gd-worse-bg);  border-color:var(--gd-worse-bd);  color:var(--gd-worse-fg);}\n.gd-chip-same   {background:var(--gd-same-bg);   border-color:var(--gd-same-bd);   color:var(--gd-same-fg);}\n\n/* Footnote */\n.gd-foot{margin-top:16px;font-family:\"JetBrains Mono\",monospace;font-size:7.5px;text-transform:uppercase;letter-spacing:.12em;color:color-mix(in oklab,var(--gd-ink) 35%,transparent);line-height:1.7;}\n\n@media(max-width:700px){\n  .gd col.gd-c1{width:96px;}\n  .gd td{padding:10px 10px !important;}\n  .gd-name{font-size:14px;}\n  .gd-old-val,.gd-new-val{font-size:12px;}\n}\n\n/* bank-lifecycle-lane.css */\n/* ════════════════════════════════════════════════════════════════════\n   BANK · LIFECYCLE-LANE  —  a horizontal lifecycle ribbon (segmented support timeline)\n   --------------------------------------------------------------------\n   A single horizontal lane of segments, each a labelled span (version +\n   date) colored by a support TYPE (full / partial / dropped), optionally\n   carrying a corner BADGE (launch / final / paid / …). Below it: status\n   NOTES (dotted annotations) and an auto-derived LEGEND. The section frame\n   (locked eyebrow + H2 + lead prose) lives in a section partial that hosts\n   this visual (e.g. _includes/sections/os-section.html).\n\n   WIDTH MODEL — two modes (set on the .lane element):\n     · .lane.uniform   every segment equal width   (default; date = label only)\n     · .lane.weighted  width ∝ time to next segment (the visual.html computes\n                        the inline flex from each segment's date — optional,\n                        contributor opts in by setting `weighted: true` + dates)\n\n   Colors: chrome (wrap / lines / ink) is SKIN-DERIVED from the base palette\n   (--foreground / --card). The support palette (full=green, partial=amber,\n   dropped=gray) + badge/note colors are SEMANTIC defaults (like the delta\n   chips) a skin may pin. The Apple defaults reproduce the original iPod look,\n   so no skin pin is needed there.\n   ════════════════════════════════════════════════════════════════════ */\n\n.lane-wrap{\n  --lane-ink:       var(--wiki-text-color, #0a0a0a);\n  --lane-bg:        color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 2%,  var(--wiki-surface-bg, #fff));\n  --lane-line:      color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 12%, transparent);\n  --lane-line-soft: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 6%,  transparent);\n  /* support palette — semantic defaults; a skin may pin any of them */\n  --lane-full-bg:#d1fae5;    --lane-full-bd:#a7f3d0;    --lane-full-dot:#6ee7b7;\n  --lane-partial-bg:#fef3c7; --lane-partial-bd:#fde68a; --lane-partial-dot:#fde68a;\n  --lane-dropped-bg: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 3.5%, var(--wiki-surface-bg, #fff));\n  --lane-dropped-bd: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 15%, transparent);\n  --lane-dropped-dot:color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 12%, transparent);\n  --lane-limited-dot:#f59e0b; --lane-final-dot:#fbbf24;\n  /* security patch — a post-EOL maintenance update, shown after the drop */\n  --lane-security-bg:#dbeafe; --lane-security-bd:#bfdbfe; --lane-security-dot:#3b82f6;\n  /* badges */\n  --lane-badge-ship-bg:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 7%, transparent);\n  --lane-badge-ship-fg:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 50%, transparent);\n  --lane-badge-paid-bg:#fbbf24;    --lane-badge-paid-fg:#78350f;\n  --lane-badge-limited-bg:#f59e0b; --lane-badge-limited-fg:#78350f;\n  --lane-badge-final-bg:   var(--wiki-text-color, #0a0a0a); --lane-badge-final-fg: var(--wiki-surface-bg, #fff);\n  --lane-badge-dropped-bg: transparent;\n  --lane-badge-dropped-bd: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 12%, transparent);\n  --lane-badge-dropped-fg: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 30%, transparent);\n  --lane-badge-security-bg:#3b82f6; --lane-badge-security-fg:#fff;\n}\n\n.lane-wrap{background:var(--lane-bg);border:1px solid var(--lane-line);border-radius:14px;padding:24px 24px 20px;}\n\n/* lead prose (optional, above the ribbon) */\n.lane-prose{max-width:720px;margin-bottom:40px;}\n\n.lane-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:var(--lane-line) transparent;margin:0 -4px;padding:0 4px;}\n.lane-scroll::-webkit-scrollbar{height:2px;}\n.lane-scroll::-webkit-scrollbar-thumb{background:var(--lane-line);border-radius:1px;}\n\n.lane-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px;gap:12px;flex-wrap:wrap;}\n.lane-title{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:16px;font-weight:600;letter-spacing:-0.01em;color:var(--lane-ink);}\n.lane-range{font-family:\"JetBrains Mono\",monospace;font-size:8px;text-transform:uppercase;letter-spacing:.14em;color:color-mix(in oklab,var(--lane-ink) 38%,transparent);white-space:nowrap;}\n\n.lane{display:flex;gap:3px;min-width:680px;}\n.lane.uniform .lane-seg{flex:1 1 0;}\n.lane-seg{border-radius:3px;padding:8px 10px;display:flex;flex-direction:column;justify-content:space-between;min-height:64px;min-width:60px;position:relative;flex-shrink:0;overflow:hidden;}\n.lane-seg.full{background:var(--lane-full-bg);border:1px solid var(--lane-full-bd);}\n.lane-seg.partial{background:var(--lane-partial-bg);border:1px solid var(--lane-partial-bd);}\n.lane-seg.dropped{background:var(--lane-dropped-bg);border:1px dashed var(--lane-dropped-bd);opacity:.7;}\n.lane-seg.security{background:var(--lane-security-bg);border:1px solid var(--lane-security-bd);}\n.lane-ver{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:13px;font-weight:600;color:var(--lane-ink);line-height:1.1;padding-right:40px;}\n.lane-seg.dropped .lane-ver{color:color-mix(in oklab,var(--lane-ink) 28%,transparent);}\n.lane-date{font-family:\"JetBrains Mono\",monospace;font-size:6.5px;text-transform:uppercase;letter-spacing:.08em;color:color-mix(in oklab,var(--lane-ink) 38%,transparent);margin-top:auto;}\n\n.lane-badge{position:absolute;top:5px;right:5px;font-family:\"JetBrains Mono\",monospace;font-size:6px;text-transform:uppercase;letter-spacing:.06em;padding:2px 4px;border-radius:2px;white-space:nowrap;max-width:calc(100% - 10px);overflow:hidden;text-overflow:ellipsis;}\n.lane-badge.ship{background:var(--lane-badge-ship-bg);color:var(--lane-badge-ship-fg);}\n.lane-badge.paid{background:var(--lane-badge-paid-bg);color:var(--lane-badge-paid-fg);}\n.lane-badge.limited{background:var(--lane-badge-limited-bg);color:var(--lane-badge-limited-fg);}\n.lane-badge.final{background:var(--lane-badge-final-bg);color:var(--lane-badge-final-fg);}\n.lane-badge.dropped{background:var(--lane-badge-dropped-bg);border:1px solid var(--lane-badge-dropped-bd);color:var(--lane-badge-dropped-fg);}\n.lane-badge.security{background:var(--lane-badge-security-bg);color:var(--lane-badge-security-fg);}\n\n.lane-notes{margin-top:14px;display:flex;gap:16px;flex-wrap:wrap;}\n.lane-note{display:flex;align-items:flex-start;gap:5px;font-size:11.5px;color:color-mix(in oklab,var(--lane-ink) 60%,transparent);max-width:260px;line-height:1.45;}\n.lane-note strong{color:var(--lane-ink);font-weight:600;}\n.lane-note-dot{width:7px;height:7px;border-radius:2px;flex-shrink:0;margin-top:4px;}\n.lane-dot-full{background:var(--lane-full-dot);}\n.lane-dot-partial{background:var(--lane-partial-dot);}\n.lane-dot-limited{background:var(--lane-limited-dot);}\n.lane-dot-final{background:var(--lane-final-dot);}\n.lane-dot-dropped{background:var(--lane-dropped-dot);}\n.lane-dot-security{background:var(--lane-security-dot);}\n\n.lane-legend{display:flex;gap:14px;margin-top:12px;padding-top:12px;border-top:1px solid var(--lane-line-soft);}\n.lane-leg{display:flex;align-items:center;gap:4px;font-family:\"JetBrains Mono\",monospace;font-size:7px;text-transform:uppercase;letter-spacing:.1em;color:color-mix(in oklab,var(--lane-ink) 42%,transparent);}\n.lane-leg-sw{width:12px;height:8px;border-radius:2px;}\n.lane-sw-full{background:var(--lane-full-bg);border:1px solid var(--lane-full-bd);}\n.lane-sw-partial{background:var(--lane-partial-bg);border:1px solid var(--lane-partial-bd);}\n.lane-sw-dropped{background:var(--lane-dropped-bg);border:1px dashed var(--lane-dropped-bd);}\n.lane-sw-security{background:var(--lane-security-bg);border:1px solid var(--lane-security-bd);}\n\n@media(max-width:600px){\n  .lane-wrap{padding:16px 14px 14px;}\n  .lane-head{flex-direction:column;gap:4px;}\n  .lane-title{font-size:14px;}\n  .lane-notes{flex-direction:column;gap:10px;}\n  .lane-note{max-width:100%;}\n  .lane-legend{flex-wrap:wrap;gap:10px;}\n  .lane-ver{padding-right:38px;}\n  .lane-badge{font-size:5px;padding:1px 3px;letter-spacing:.04em;}\n  .lane-seg{min-width:64px;}\n}\n\n/* bank-photo-rail.css */\n/* ════════════════════════════════════════════════════════════════════\n   bank-photo-rail.css — single source for the PHOTO-RAIL bank.\n   A headerless, full-bleed horizontal scroller of image cards (image + bold\n   label + caption) on a toned band, with an optional click-to-zoom lightbox.\n   Skin-tokenized via --prail-* (defaults reproduce the Apple dark-band look).\n   ════════════════════════════════════════════════════════════════════ */\n.photo-rail-scroll{ display:flex; align-items:center; gap:12px; overflow-x:auto; overflow-y:hidden;\n  scrollbar-width:none; -webkit-overflow-scrolling:touch; padding-block:8px; padding-right:48px; }\n.photo-rail-scroll::-webkit-scrollbar{ display:none; }\n.photo-rail-card{ flex-shrink:0; width:280px; height:200px; border-radius:8px; overflow:hidden;\n  position:relative; cursor:zoom-in; border:1px solid var(--prail-card-border, rgba(255,255,255,.08)); }\n.photo-rail-card img{ width:100%; height:100%; object-fit:cover; display:block;\n  transition:transform .35s ease; image-rendering:-webkit-optimize-contrast; }\n.photo-rail-card:hover img{ transform:scale(1.04); }\n.photo-rail-caption{ position:absolute; bottom:0; left:0; right:0; padding:18px 10px 8px;\n  background:linear-gradient(to top, var(--prail-cap-scrim, rgba(0,0,0,.72)) 0%, transparent 100%);\n  font-family:\"JetBrains Mono\",monospace; font-size:8px; text-transform:uppercase; letter-spacing:.14em;\n  color:var(--prail-cap, rgba(255,255,255,.75)); line-height:1.5; }\n.photo-rail-caption strong{ display:block; font-size:9px; color:var(--prail-cap-strong, #fff); margin-bottom:2px; letter-spacing:.1em; }\n.photo-rail-caption .prail-cap-line{ display:block; }\n.photo-rail-caption .prail-cap-src{ display:block; opacity:.82; margin-top:2px; }\n/* keep empty optional lines from reserving space on the live page */\n.photo-rail-caption .prail-cap-line:empty,\n.photo-rail-caption .prail-cap-src:empty{ display:none; }\n@media(max-width:600px){\n  .photo-rail-card{ width:200px; height:148px; }\n  .photo-rail-scroll{ padding:8px 12px 8px 0; }\n}\n/* click-to-zoom lightbox — the rail's live-only script injects #rail-lb once */\n.rail-lb{ display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.85); align-items:center; justify-content:center; }\n.rail-lb.open{ display:flex; }\n.rail-lb-img{ max-width:90vw; max-height:85vh; border-radius:8px; box-shadow:0 24px 64px rgba(0,0,0,.5); }\n.rail-lb-x{ position:fixed; top:18px; right:22px; width:40px; height:40px; border:0; border-radius:50%;\n  background:rgba(255,255,255,.12); color:#fff; font-size:20px; line-height:1; cursor:pointer; }\n.rail-lb-x:hover{ background:rgba(255,255,255,.22); }\n.rail-lb-cap{ position:fixed; bottom:22px; left:0; right:0; text-align:center; color:rgba(255,255,255,.8);\n  font-family:\"JetBrains Mono\",monospace; font-size:10px; letter-spacing:.1em; }\n\n/* bank-spec.css */\n/* ════════════════════════════════════════════════════════════════════\n   BANK · SPEC SHEET  (the full \"Specifications Sheet\" — a grid of cards)\n   --------------------------------------------------------------------\n   A grid of spec CARDS, each an icon + title + a list of key/value rows.\n   The section frame (locked \"Specifications Sheet\" eyebrow + file-text icon,\n   the H2 title, the required device sub-line) lives in\n   _includes/sections/spec-section.html; this file owns the grid + cards.\n\n   Colors are SKIN-DERIVED and NORMAL (light surface, dark text — not the\n   old inverted dark band). The chart reads --spec-* tokens defaulting from\n   the wiki's base palette (--foreground / --card); a skin can pin them.\n   ════════════════════════════════════════════════════════════════════ */\n\n.spec{\n  --spec-ink:     var(--wiki-text-color, #0a0a0a);                                          /* text */\n  --spec-surface: var(--wiki-surface-bg, #fff);                                                   /* card bg */\n  --spec-line:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 12%, transparent);    /* borders */\n  --spec-divider: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 8%,  transparent);    /* the grid gaps */\n}\n\n/* INVERTED look on the dark \"special\" band (the spec sheet's signature):\n   flip the card tokens to dark cards + light text. One place → all pages. */\n.spec[data-tone=\"special\"]{\n  --spec-ink:     var(--wiki-surface-bg, #fff);\n  --spec-surface: color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 93%, var(--wiki-surface-bg, #fff));\n  --spec-line:    color-mix(in oklab, var(--wiki-surface-bg, #fff) 12%, transparent);\n  --spec-divider: color-mix(in oklab, var(--wiki-surface-bg, #fff) 10%, transparent);\n}\n\n/* required device sub-line (name · model number) */\n.spec-sub{font-family:\"JetBrains Mono\",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.16em;color:color-mix(in oklab,var(--spec-ink) 42%,transparent);margin:0 0 36px;}\n\n/* card grid — the 1px gaps bleed the divider color as hairlines */\n.spec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--spec-divider);border:1px solid var(--spec-line);border-radius:16px;overflow:hidden;}\n.spec-card{background:var(--spec-surface);padding:24px 24px 26px;}\n.spec-card-head{display:flex;align-items:center;gap:8px;font-family:\"JetBrains Mono\",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.18em;color:var(--spec-ink);margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--spec-line);}\n.spec-card-head svg,.spec-card-head .wiki-icon{width:13px;height:13px;color:color-mix(in oklab,var(--spec-ink) 55%,transparent);flex-shrink:0;}\n.spec-list{display:flex;flex-direction:column;gap:11px;margin:0;}\n.spec-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0;}\n.spec-k{font-size:12.5px;color:color-mix(in oklab,var(--spec-ink) 48%,transparent);flex-shrink:0;margin:0;}\n.spec-v{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:13px;font-weight:500;color:var(--spec-ink);text-align:right;letter-spacing:-0.005em;line-height:1.35;margin:0;}\n\n/* ── Mobile: single-column stack with full-bleed dividers ──────────── */\n@media(max-width:760px){\n  .spec-sub{margin-bottom:28px;}\n  .spec-grid{grid-template-columns:1fr;gap:0;border-radius:14px;background:var(--spec-surface);}\n  .spec-card{padding:22px 18px;border-bottom:1px solid var(--spec-line);}\n  .spec-card:last-child{border-bottom:none;}\n  .spec-card-head{margin-bottom:14px;padding-bottom:12px;font-size:9.5px;letter-spacing:.16em;}\n  .spec-row{padding:2px 0;}\n  .spec-k{font-size:13px;}\n  .spec-v{font-size:14px;}\n}\n@media(max-width:380px){\n  .spec-row{flex-direction:column;align-items:flex-start;gap:2px;}\n  .spec-v{text-align:left;}\n}\n\n/* bank-timeline.css */\n/* ════════════════════════════════════════════════════════════════════\n   BANK · TIMELINE  (+ paired station card + detail modal)\n   --------------------------------------------------------------------\n   The horizontal, full-bleed, date-positioned timeline. Structure + type\n   live here (single source); the section frame lives in\n   _includes/sections/timeline-section.html. The scroller bleeds edge-to-\n   edge via the universal .wiki-section-bleed.\n\n   Colors are SKIN-DERIVED (same pattern as the config bank). The chart\n   reads --tl-* tokens, each defaulting to a mix of the wiki's base palette\n   (--foreground / --card / --wiki-accent), so any wiki gets a coherent timeline\n   (alternating year bands, an accent on each card's left edge, light\n   chrome). A skin can pin a token to lock a look — the Apple skin pins the\n   originals (#0a0a0a / #fff / …) via `body.wiki-apple .timeline { … }` so\n   the iPod timeline is unchanged.\n   ════════════════════════════════════════════════════════════════════ */\n\n/* ── skin-derived chrome tokens (defined once; a skin can override) ──── */\n.timeline{\n  --tl-ink:     var(--wiki-text-color, #0a0a0a);                                                   /* text */\n  --tl-surface: var(--wiki-surface-bg, #fff);                                                            /* card + modal bg */\n  --tl-accent:  var(--wiki-accent-on-light, var(--wiki-text-color, #0a0a0a));                               /* left card edge, dot, modal bar — the wiki's brand accent */\n  --tl-line:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 8%, transparent);              /* hairlines / borders / spine */\n  --tl-band:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 2.5%, transparent);            /* alternating year panel */\n  --tl-chip:    color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 9%, var(--wiki-surface-bg, #fff));        /* gap chip bg */\n  --tl-footer:  color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 2%, var(--wiki-surface-bg, #fff));        /* modal footer bg */\n  --tl-dim:     color-mix(in oklab, var(--wiki-text-color, #0a0a0a) 45%, transparent);             /* modal overlay */\n}\n\n.tl-hdr{max-width:1320px;margin:0 auto;padding:0 48px 32px;}\n.tl-scroll-hint{display:flex;align-items:center;gap:6px;font-family:\"JetBrains Mono\",monospace;font-size:9px;text-transform:uppercase;letter-spacing:.18em;color:color-mix(in oklab,var(--tl-ink) 35%,transparent);margin-top:12px;}\n.tl-outer{overflow-x:auto;-webkit-overflow-scrolling:touch;cursor:grab;padding-bottom:36px;scrollbar-width:none;}\n.tl-outer::-webkit-scrollbar{display:none;}\n.track{position:relative;display:block;}\n.tl-band{position:absolute;top:0;bottom:0;background:var(--tl-band);pointer-events:none;}\n.tl-spine{position:absolute;left:0;right:0;top:339px;height:1px;background:var(--tl-line);z-index:1;pointer-events:none;}\n.tl-band-even{background:transparent;pointer-events:none;}\n.tl-ruler{position:absolute;bottom:4px;left:0;right:0;pointer-events:none;}\n.tl-yr{position:absolute;bottom:0;transform:translateX(-50%);}\n.tl-yr span{font-family:\"JetBrains Mono\",monospace;font-size:8px;text-transform:uppercase;letter-spacing:.14em;color:color-mix(in oklab,var(--tl-ink) 28%,transparent);}\n.itl-station{position:absolute;top:0;}\n.itl-event-top{width:210px;margin:0 auto;height:340px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-start;padding-top:20px;overflow:visible;position:relative;}\n.sc-float-date{padding:0 0 8px 0;display:flex;align-items:baseline;gap:6px;}\n.sc-float-month,.sc-float-day,.sc-float-year{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:22px;font-weight:600;letter-spacing:-0.02em;color:color-mix(in oklab,var(--tl-ink) 25%,transparent);line-height:1;}\n.sc-float-day{font-weight:700;}\n.itl-card{background:var(--tl-surface);border-radius:12px;border:1px solid var(--tl-line);box-shadow:0 1px 2px color-mix(in oklab,var(--tl-ink) 4%,transparent),0 4px 16px color-mix(in oklab,var(--tl-ink) 8%,transparent);overflow:hidden;position:relative;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease;width:100%;}\n.itl-card:hover{transform:translateY(-3px);box-shadow:0 2px 4px color-mix(in oklab,var(--tl-ink) 5%,transparent),0 12px 32px color-mix(in oklab,var(--tl-ink) 13%,transparent);}\n.sc-bar{position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--tl-accent);}\n.sc-body{padding:15px 15px 13px 18px;}\n.sc-tag{font-family:\"JetBrains Mono\",monospace;font-size:8px;text-transform:uppercase;letter-spacing:.18em;color:color-mix(in oklab,var(--tl-ink) 38%,transparent);margin-bottom:7px;}\n.sc-title{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:16px;font-weight:600;letter-spacing:-0.02em;line-height:1.2;color:var(--tl-ink);margin-bottom:7px;}\n.sc-prose{font-size:11.5px;color:color-mix(in oklab,var(--tl-ink) 52%,transparent);line-height:1.58;margin-bottom:12px;}\n.sc-footer{display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid var(--tl-line);}\n.sc-expand{font-family:\"JetBrains Mono\",monospace;font-size:7.5px;text-transform:uppercase;letter-spacing:.14em;color:color-mix(in oklab,var(--tl-ink) 32%,transparent);display:flex;align-items:center;gap:4px;}\n.sc-num{font-family:\"JetBrains Mono\",monospace;font-size:7.5px;color:color-mix(in oklab,var(--tl-ink) 16%,transparent);}\n/* connector: a 1px line from the card's bottom down to the spine dot. flex:1\n   in the fixed-height .itl-event-top column makes it fill exactly the gap\n   beneath the (content-height) card — adapts per card, no JS (the old engine\n   measured + drew this at runtime). min-height:0 → no line when a card is tall\n   enough to reach the spine on its own. */\n.sc-connector{flex:1 1 auto;min-height:0;width:1px;align-self:center;background:var(--tl-line);pointer-events:none;position:relative;z-index:1;}\n.itl-spine{position:absolute;left:50%;transform:translateX(-50%);top:335px;width:9px;height:9px;}\n.itl-dot{width:9px;height:9px;border-radius:50%;background:var(--tl-accent);position:relative;z-index:4;flex-shrink:0;}\n.tl-gap{position:absolute;transform:translate(-50%,-50%);background:var(--tl-chip);border:1px solid var(--tl-line);border-radius:3px;padding:3px 8px;font-family:\"JetBrains Mono\",monospace;font-size:7.5px;text-transform:uppercase;letter-spacing:.1em;color:color-mix(in oklab,var(--tl-ink) 45%,transparent);white-space:nowrap;z-index:3;pointer-events:none;}\n.tl-details{display:none;}\n.tl-modal{display:none;position:fixed;inset:0;background:var(--tl-dim);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:9999;align-items:center;justify-content:center;padding:24px;}\n.tl-modal.open{display:flex;}\n.tl-modal-box{width:min(440px, calc(100vw - 48px));max-height:calc(100vh - 80px);background:var(--tl-surface);border-radius:12px;border:1px solid var(--tl-line);box-shadow:0 4px 8px color-mix(in oklab,var(--tl-ink) 6%,transparent),0 32px 80px color-mix(in oklab,var(--tl-ink) 22%,transparent);overflow:hidden;position:relative;display:flex;flex-direction:column;}\n.tl-modal-bar{position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--tl-accent);}\n.tl-modal-header{padding:20px 20px 18px 24px;border-bottom:1px solid var(--tl-line);flex-shrink:0;}\n.tl-modal-tag{font-family:\"JetBrains Mono\",monospace;font-size:8.5px;text-transform:uppercase;letter-spacing:.18em;color:color-mix(in oklab,var(--tl-ink) 38%,transparent);margin-bottom:10px;}\n.tl-modal-title{font-family:\"Fraunces\",Georgia,serif;font-variation-settings:\"SOFT\" 30,\"WONK\" 0;font-size:22px;font-weight:600;letter-spacing:-0.025em;line-height:1.15;color:var(--tl-ink);}\n.tl-modal-body{padding:20px 20px 22px 24px;overflow-y:auto;flex:1;}\n.tl-modal-body p{font-family:\"Spectral\",Georgia,serif;font-size:13.5px;color:color-mix(in oklab,var(--tl-ink) 70%,transparent);line-height:1.75;margin-bottom:14px;}\n.tl-modal-body p:last-child{margin-bottom:0;}\n.tl-modal-body p strong{color:var(--tl-ink);font-weight:600;}\n.tl-modal-footer{padding:12px 20px 14px 24px;border-top:1px solid var(--tl-line);background:var(--tl-footer);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}\n.tl-modal-close{font-family:\"JetBrains Mono\",monospace;font-size:7.5px;text-transform:uppercase;letter-spacing:.14em;color:color-mix(in oklab,var(--tl-ink) 35%,transparent);background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:5px;padding:0;transition:color .15s;}\n.tl-modal-close:hover{color:var(--tl-ink);}\n.tl-modal-page{font-family:\"JetBrains Mono\",monospace;font-size:8px;color:color-mix(in oklab,var(--tl-ink) 22%,transparent);}\n@media(max-width:600px){.tl-hdr{padding:0 16px 24px;}.tl-scroll-hint{font-size:8px;}.tl-modal-box{width:calc(100vw - 32px);}}\n"